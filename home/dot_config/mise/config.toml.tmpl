# https://mise.jdx.dev/registry.html

min_version = '2026.6.11'

[settings]
experimental = true
minimum_release_age = "3d"
trusted_config_paths = [
  '~/workspace'
]

[settings.cargo]
binstall = true

[tools]
rust = "latest"
cargo-binstall = "latest"
#"cargo:ripgrep" = "latest"
go = "latest"
golangci-lint = "latest"
gofumpt = "latest"
buf = "latest"
"go:github.com/google/osv-scanner/v2/cmd/osv-scanner" = "latest"
"go:github.com/prometheus/alertmanager/cmd/amtool" = "latest"
{{ if ne .chezmoi.os "windows" -}}
"go:github.com/grafana/mcp-grafana/cmd/mcp-grafana" = "latest"
{{ end -}}
java = "latest"
python = "latest"
{{ if ne .chezmoi.os "windows" -}}
"pipx:cisco-ai-skill-scanner" = "latest"
"pipx:snyk-agent-scan" = "latest"
{{ end -}}
uv = "latest"
node = "latest"
npm = "latest"
"npm:knip" = "latest"
"npm:aws-cdk" = "latest"
"npm:openwiki" = "latest"
aube = "latest"
aws-sam = "latest"
terraform = "latest"
tflint = "latest"
trivy = "latest"
snyk = "latest"
cloudflared = "latest"
argocd = "latest"
argo-rollouts = "latest"
kubectl = "latest"
helm = "latest"
istioctl = "latest"
promtool = "latest"
"ubi:prometheus/alertmanager" = "latest"
mimirtool = "latest"
loki-logcli = "3"
"aqua:grafana/gcx" = "latest"
"github:opengrep/opengrep" = "latest"
k9s = "latest"
k6 = "latest"

"aqua:prometheus/prometheus" = "latest"
"aqua:cocogitto/cocogitto" = "latest"
{{ if ne .chezmoi.os "windows" -}}
"aqua:aws/session-manager-plugin" = "latest"
{{ end -}}

jq = "latest"
yq = "latest"
fzf = "latest"
